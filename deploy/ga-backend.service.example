[Unit]
Description=GA WebUI WebAPI Adapter for GenericAgent
After=network.target

[Service]
Type=simple
User=<deploy-user>
WorkingDirectory=/opt/ga-webui
EnvironmentFile=/opt/ga-webui/.env.webapi
ExecStart=/opt/ga-webui/.venv/bin/python -m webapi.server
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
