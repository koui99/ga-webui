[Unit]
Description=GenericAgent Python Adapter (FastAPI)
After=network.target

[Service]
Type=simple
User=<deploy-user>
WorkingDirectory=/opt/genericagent
Environment="GA_PORT=8765"
Environment="GA_REPO_ROOT=/opt/genericagent"
Environment="GA_IMAGE_PROVIDER=mock"
# 需要时取消注释：
# Environment="FAL_KEY=<your-fal-key>"
# Environment="OPENAI_API_KEY=<your-openai-key>"
# Environment="AI_GATEWAY_API_KEY=<your-gateway-key>"
ExecStart=/opt/genericagent/.venv/bin/python -m webapi.server
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
